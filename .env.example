# PostgreSQL de desenvolvimento (Docker Compose)
POSTGRES_DB=organizows_dev
POSTGRES_USER=organizows_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Backend Spring Boot (perfil dev)
# Preencha DEV_DB_PASSWORD com a mesma senha de POSTGRES_PASSWORD.
# Se alterar porta, banco ou usuário acima, ajuste os campos JDBC correspondentes.
DEV_DB_URL=jdbc:postgresql://127.0.0.1:5433/organizows_dev
DEV_DB_DRIVER=org.postgresql.Driver
DEV_DB_USER=organizows_dev
DEV_DB_PASSWORD=
